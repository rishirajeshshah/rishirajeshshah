# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Database (overridden by docker-compose.yml env section) ──────────────────
DATABASE_URL=postgresql+asyncpg://isp:isp@localhost:5432/isp
DATABASE_URL_SYNC=postgresql+psycopg2://isp:isp@localhost:5432/isp

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
IDEMPOTENCY_KEY_TTL_DAYS=30

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── API Auth ──────────────────────────────────────────────────────────────────
# Include this header in all API requests: X-API-Key: dev-api-key-change-in-prod
ADMIN_API_KEY=dev-api-key-change-in-prod

# ── NetSuite (leave empty to use demo mode) ───────────────────────────────────
# Demo mode generates 10 sample invoices without real API calls.
# Set NETSUITE_DEMO_MODE=false and provide credentials to connect to real NetSuite.
NETSUITE_DEMO_MODE=true
NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=

# ── PayPal (leave empty to use demo mode) ─────────────────────────────────────
# Demo mode simulates successful invoice creation without real API calls.
# Set PAYPAL_DEMO_MODE=false and provide sandbox credentials from developer.paypal.com
PAYPAL_DEMO_MODE=true
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Sync Engine ───────────────────────────────────────────────────────────────
SYNC_RETRY_MAX_ATTEMPTS=5
SYNC_RETRY_INITIAL_DELAY_MS=1000
SYNC_RETRY_BACKOFF_MULTIPLIER=2.0
SYNC_RETRY_MAX_DELAY_MS=300000
SYNC_CONCURRENCY=10
SYNC_BATCH_SIZE=100
